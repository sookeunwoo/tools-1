#!/bin/sh
# dk 런처.
#
# --disable-warning: node:sqlite의 ExperimentalWarning을 끈다. stderr에 섞이면
#   에이전트가 툴 출력을 파싱할 때 잡음이 된다. JS 레벨에서 process.emitWarning을
#   덮어쓰는 방법은 통하지 않는다(Node가 모듈 로드 시점에 내부 경로로 발행).
# NODE_COMPILE_CACHE: 타입 스트리핑 결과와 V8 코드 캐시를 재사용한다.
#   빌드 단계를 들이지 않고 `.ts` 직접 실행의 고정비를 걷어내는 방법이다
#   (어댑터 기준 RSS 86MB → 55MB, 기동 86ms → 56ms 실측).
#   소스가 바뀌면 Node가 알아서 새 항목을 만든다 — 수동 재생성이 필요 없고,
#   "파일을 고치면 바로 반영된다"는 전제가 그대로 유지된다.
export NODE_COMPILE_CACHE="${NODE_COMPILE_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/devkit/node-compile}"

exec node --disable-warning=ExperimentalWarning \
  "$(cd "$(dirname "$0")/.." && pwd)/apps/cli/src/main.ts" "$@"
