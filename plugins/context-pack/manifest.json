{
  "name": "context-pack",
  "version": "0.1.0",
  "summary": "현재 작업 상태를 4KB 이하 브리핑으로 압축한다 — 새 세션의 씨앗",
  "whenToUse": "세션이 길어져 컨텍스트가 부풀었을 때, 그 세션을 끝내고 새 세션을 열기 직전에 호출한다. 출력된 마크다운을 새 세션의 첫 프롬프트로 그대로 붙이면 작업 맥락이 복원된다. 티켓 착수 시점에 무엇을 건드려야 하는지 파악할 때도 쓴다. 코드 흐름 추적이 필요하면 이 툴 말고 trace-flow를 쓴다.",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["repo", "task"],
    "properties": {
      "repo": { "type": "string", "description": "설정에 등록된 저장소 이름" },
      "task": { "type": "string", "minLength": 1, "description": "작업 한 줄 설명" },
      "ticket": { "type": "string", "description": "티켓 ID (선택)" },
      "baseRef": { "type": "string", "description": "비교 기준. 생략하면 origin/main → main → HEAD~1 순으로 탐지" },
      "files": {
        "type": "array",
        "items": { "type": "string" },
        "description": "대상 파일을 명시. 생략하면 git diff에서 도출한다"
      },
      "dod": {
        "type": "array",
        "items": { "type": "string" },
        "description": "완료 기준. 자동 생성 항목에 추가된다"
      },
      "budgetKb": { "type": "number", "default": 4, "minimum": 1, "maximum": 16 }
    }
  },
  "outputSchema": {
    "type": "object",
    "required": ["briefing", "sizeBytes", "withinBudget"],
    "properties": {
      "briefing": { "type": "string", "description": "새 세션 첫 프롬프트에 그대로 붙이는 마크다운" },
      "sizeBytes": { "type": "integer" },
      "withinBudget": { "type": "boolean" },
      "targetFiles": { "type": "array" },
      "testGaps": { "type": "array", "items": { "type": "string" } }
    }
  },
  "sideEffects": "read",
  "concurrency": { "mode": "safe", "resourceKey": null },
  "determinism": "nondeterministic",
  "timeoutSec": 60,
  "requiresApproval": false,
  "costHint": "cheap"
}
