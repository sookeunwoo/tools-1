{
  "name": "trace-flow",
  "version": "0.1.0",
  "summary": "엔드포인트에서 다운스트림까지 호출 흐름과 리스크 포인트를 추적한다",
  "whenToUse": "티켓의 as-is를 파악할 때, 어떤 API가 무엇을 건드리는지(DB 테이블·외부 시스템·이벤트) 조사할 때, 설계 문서를 쓰기 전 사이드이펙트를 확인할 때 쓴다. 코드를 직접 여러 번 읽는 대신 이 툴 한 번으로 대체한다. 먼저 repo-map으로 인덱스가 만들어져 있어야 한다. 변경의 영향 반경(역방향)이 궁금하면 impact-scan을 쓴다.",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["repo", "entry"],
    "properties": {
      "repo": { "type": "string", "description": "설정에 등록된 저장소 이름" },
      "entry": {
        "type": "string",
        "description": "진입점. \"POST /v1/orders\" 같은 엔드포인트 키 또는 \"OrderService.confirm\" 형식"
      },
      "maxDepth": { "type": "integer", "default": 6, "minimum": 1, "maximum": 15 },
      "mode": { "enum": ["summary", "full"], "default": "summary" }
    }
  },
  "outputSchema": {
    "type": "object",
    "required": ["entry", "nodes", "edges"],
    "properties": {
      "entry": { "type": "object" },
      "nodes": { "type": "array" },
      "edges": { "type": "array" },
      "tables": { "type": "array" },
      "externals": { "type": "array" },
      "events": { "type": "array" },
      "riskPoints": { "type": "array" }
    }
  },
  "sideEffects": "read",
  "concurrency": { "mode": "safe", "resourceKey": null },
  "determinism": "by-commit",
  "timeoutSec": 120,
  "requiresApproval": false,
  "costHint": "cheap"
}
